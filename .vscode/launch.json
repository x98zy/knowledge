{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Debug",
      "type": "debugpy",
      "cwd": "${workspaceFolder}/api",
      "request": "launch",
      "module": "uvicorn",
      "python": "${workspaceFolder}/api/.venv/Scripts/python.exe",
      "args": [
        "main:app",
        "--host", "0.0.0.0",
        "--port", "8000",
        "--reload"
      ],
      "jinja": true,
      "justMyCode": true
    }
  ]
}
